# RCON is bound to 127.0.0.1, but still gets a strong password. Alphanumeric so it needs no escaping
# in server.properties.
resource "random_password" "rcon" {
  length  = 32
  special = false
}

# Losing this means losing the backups. Terraform state (R2) is the only store (plus the Actions secret),
# so keep a copy in a password manager: terraform output -raw restic_password.
resource "random_password" "restic" {
  length  = 48
  special = false
}

locals {
  restic_repository = "s3:${local.r2_endpoint}/${cloudflare_r2_bucket.backups.name}"

  # Optional secrets: only created when set (an absent secret reads as "" in a workflow, which turns the
  # feature off). Whether one is set isn't secret; its value stays sensitive.
  optional_actions_secrets = {
    DISCORD_WEBHOOK_URL = var.discord_webhook_url
    # Only while the product repo is private: lets the reusable workflow check out the product.
    PRODUCT_READ_TOKEN = var.product_read_token
    # P11: the updater GitHub App (weekly update PRs + auto-merge); only the scheduled update job reads them.
    # The panel's App key is NOT here: it lives in the Worker only (panel.tf).
    UPDATER_APP_ID  = var.updater_github_app_id
    UPDATER_APP_KEY = var.updater_github_app_private_key == "" ? "" : base64decode(var.updater_github_app_private_key)
  }

  # Everything the deploy needs reaches CI only as Actions secrets of the config repo. Its workflow passes them
  # explicitly to the product's reusable workflow, which maps them to MC_SECRET_*
  # for Ansible). The names are listed once in mcctl/secrets.py; tests/test_consistency.py keeps this
  # map, the outputs and the workflows in step with it.
  actions_secrets = merge(
    {
      # Federated identity (not secret, but kept beside the other Tailscale inputs). The audience is
      # generated by Tailscale at creation.
      TS_OAUTH_CLIENT_ID = tailscale_federated_identity.ci.id
      TS_AUDIENCE        = tailscale_federated_identity.ci.audience
      RCON_PASSWORD      = random_password.rcon.result
      # Also used by the reusable workflow's backup-check task (manual) to verify backups from outside the server.
      RESTIC_REPOSITORY    = local.restic_repository
      RESTIC_PASSWORD      = random_password.restic.result
      R2_ACCESS_KEY_ID     = local.r2_access_key_id
      R2_SECRET_ACCESS_KEY = local.r2_secret_access_key
      HEARTBEAT_TOKEN      = random_password.heartbeat.result
      AGENT_TOKEN          = random_password.agent_token.result
      COMMAND_HMAC_KEY     = random_password.command_hmac_key.result
      # v1.1: the deploy job's uploads to the artifact mirror (never Ansible's, never on the server)
      ARTIFACT_PUBLISH_TOKEN = random_password.publish_token.result
    },
    { for k, v in local.optional_actions_secrets : k => v if nonsensitive(v != "") },
  )
}

# --- Where each secret lives (security review M2) ---------------------------------------------------------------
#
# Repository-level Actions secrets are readable by ANY workflow run in the config repo, including one pushed to an
# update/* or panel/* branch (which the rulesets leave open to the GitHub Apps; the updater App has Workflows
# write). With server.yml github.environments, each secret is a secret of a GitHub Environment instead, and each
# environment admits jobs on main only (deployment branch policy), whose workflow file the rulesets protect:
#   deploy: everything the deploy, backup-check and expiry-check jobs read;
#   update: the updater App's id and key (only the scheduled update job).
# PRODUCT_READ_TOKEN (contents: read on the product, only while it is private) stays repository-level: every
# job checks out the product with it, and it can't change anything.
# Environments of a private personal repo need a paid plan (GitHub Pro), like rulesets: on GitHub Free set
# github.environments: false (`mcctl setup` / `mcctl doctor` probe it) and read SECURITY.md.
#
# Migrating an existing deployment (repository-level secrets -> environments): Terraform destroys the orphaned
# repository secrets before it creates anything new (orphans are ordered by their state, not the config), so
# create the environments first and remove the old secrets in a second apply (CHANGELOG, docs/operations.md):
#   mcctl apply --target github_actions_environment_secret.this   # environments, branch policies, secrets
#   mcctl apply                                                    # repository secrets go, CI subject changes
# A deploy that starts while a secret is missing fails at site.yml's "Check secrets are present" before it
# changes anything. Resources checked against the github provider 6.13.0 schema.
locals {
  update_environment_secrets = toset(["UPDATER_APP_ID", "UPDATER_APP_KEY"])
  repository_level_secrets   = toset(["PRODUCT_READ_TOKEN"])
  # Secret name -> environment (static keys; only the values are sensitive).
  environment_of_secret = var.github_environments ? {
    for k in nonsensitive(keys(local.actions_secrets)) :
    k => contains(local.update_environment_secrets, k) ? "update" : "deploy"
    if !contains(local.repository_level_secrets, k)
  } : {}
  github_environments = var.github_environments ? toset(["deploy", "update"]) : toset([])
}

resource "github_repository_environment" "this" {
  for_each = local.github_environments

  repository  = var.github_repository
  environment = each.key

  deployment_branch_policy {
    protected_branches     = false
    custom_branch_policies = true
  }
}

# The only branch that may use either environment: main (a pull request's or any other branch's jobs are refused
# before they start, so they never see the environment's secrets).
resource "github_repository_environment_deployment_policy" "main" {
  for_each = local.github_environments

  repository     = var.github_repository
  environment    = github_repository_environment.this[each.key].environment
  branch_pattern = "main"
}

resource "github_actions_environment_secret" "this" {
  for_each = local.environment_of_secret

  repository  = var.github_repository
  environment = github_repository_environment.this[each.value].environment
  secret_name = each.key
  value       = local.actions_secrets[each.key]

  # Secrets only once the branch policy is in place: never an environment that any branch may use.
  depends_on = [github_repository_environment_deployment_policy.main]
}

resource "github_actions_secret" "this" {
  # Keys are static; only the values are sensitive. With environments, only the repository-level ones.
  for_each = toset([for k in nonsensitive(keys(local.actions_secrets)) : k if !contains(keys(local.environment_of_secret), k)])

  repository  = var.github_repository
  secret_name = each.key
  value       = local.actions_secrets[each.key]
}

# No Actions variables: the reusable workflow reads deploy.enabled, the server address and the tailnet name
# straight from server.yml (validate job outputs), so flipping deploy.enabled needs a commit, not an apply.

# --- Branch rulesets (P10 review: the panel's GitHub App must not be able to change what gets deployed) --------
#
# Whatever reaches main is deployed (lock files -> the jar that runs as minecraft, ops, every setting), so main
# takes changes only through pull requests whose required checks passed, and never by force-push or deletion.
# `server / gate` (the reusable workflow's gate job) passes only for what may merge without a human: a
# whitelist-only players.yml change, a same-version lock update whose hashes match the upstream APIs, a product
# patch bump to a released tag. Anything else needs the admin, who bypasses (merge as admin, or push to main).
# The checks are pinned to the GitHub Actions app, so an App or token that could post statuses can't fake them.
# Neither GitHub App is a bypass actor. Arguments checked against the github provider 6.13.0 schema.
# GitHub's docs list rulesets on private repositories of personal accounts as a GitHub Pro feature: on GitHub
# Free set server.yml github.protect_main: false and read SECURITY.md (the App could then push to main).
locals {
  github_actions_app_id = 15368 # the "GitHub Actions" app (integration id of checks created by workflow runs)
  # Repository role ids (GitHub REST "rules"): 5 = admin. The owner of a personal repository is its admin.
  github_admin_role_id = 5
}

resource "github_repository_ruleset" "main" {
  count = var.github_protect_main ? 1 : 0

  name        = "main: pull requests with checks (mcctl)"
  repository  = var.github_repository
  target      = "branch"
  enforcement = "active"

  conditions {
    ref_name {
      include = ["~DEFAULT_BRANCH"]
      exclude = []
    }
  }

  bypass_actors {
    actor_id    = local.github_admin_role_id
    actor_type  = "RepositoryRole"
    bypass_mode = "always"
  }

  rules {
    deletion         = true
    non_fast_forward = true

    pull_request {
      required_approving_review_count = 0 # one admin: the gate check decides what merges unattended
      dismiss_stale_reviews_on_push   = true
    }

    # p11-review: strict = the branch must be up to date with main, so a gate verdict judged against an older main
    # (e.g. before an auto_merge or players.yml change landed) can't merge stale; the check re-runs on the update.
    required_status_checks {
      strict_required_status_checks_policy = true
      required_check {
        context        = "server / validate"
        integration_id = local.github_actions_app_id
      }
      required_check {
        context        = "server / gate"
        integration_id = local.github_actions_app_id
      }
    }
  }
}

# Every other branch except panel/* and update/*: only the admin may create, update or delete it.
#
# First live apply (2026-11-01): the earlier design also made the updater App a bypass actor (so update/* could
# only come from it), and GitHub refused the ruleset with 422 "Actor <app> integration must be part of the
# ruleset source or owner organization": on a repository owned by a PERSONAL account an App can't be a bypass
# actor. So update/* (like panel/*) stays writable by both installed Apps, and what binds a policy to its App
# is `mcctl pr-gate` (mcctl/gate.py): a lock or product update merges unattended only when the pull request was
# opened by the updater App's bot user AND the event that ran the gate was sent by it (a push by the panel App to
# an update/* branch fails the gate), and a whitelist change only when both are the panel App's bot. The App
# slugs come from server.yml github.updater_app / github.panel_app as of the BASE commit. The panel App still
# can't touch any other branch, and it has no Workflows permission, so it can't push a product bump at all.
resource "github_repository_ruleset" "branches" {
  count = var.github_protect_main ? 1 : 0

  name        = "branches: admin only; panel/* and update/* for the Apps (mcctl)"
  repository  = var.github_repository
  target      = "branch"
  enforcement = "active"

  conditions {
    ref_name {
      include = ["~ALL"]
      exclude = ["~DEFAULT_BRANCH", "refs/heads/panel/**", "refs/heads/update/**"]
    }
  }

  bypass_actors {
    actor_id    = local.github_admin_role_id
    actor_type  = "RepositoryRole"
    bypass_mode = "always"
  }

  rules {
    creation = true
    update   = true
    deletion = true
  }
}
