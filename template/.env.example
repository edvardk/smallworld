# Admin credentials for this config repo. Copy to .env (git-ignored, chmod 600) and fill in.
# mcctl reads it itself (variables already set in your shell win) and refuses it unless it is mode 600;
# `mcctl doctor` checks every token and records expiry dates in expiry.yml. Never commit values; CI never
# sees these.
#
# Dashlane (optional): any value may be a Dashlane secret reference instead, e.g.
#   CLOUDFLARE_API_TOKEN=dl://mcctl-<name>-cloudflare-api-token/password
# mcctl resolves it with the Dashlane CLI (`dcli read`) when it runs, in memory only. `mcctl secrets dashlane`
# lists the items to create (dcli can't create them); `--convert` swaps values for references that read back.

# --- Terraform state backend: the R2 bucket in server.yml state.bucket (token scoped to that bucket) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# https://<cloudflare-account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL_S3=

# --- Cloudflare provider ---
# `mcctl init` mints this from a one-time "Create additional tokens" token (and deletes that one). By hand:
# Zone > DNS > Edit + Zone > Zone > Read (your zone), Account > Workers R2 Storage > Edit, User > API Tokens > Edit,
# Account > Workers Scripts > Edit and Account > D1 > Edit (the watchdog Worker and its state database); panel
# mode cloudflare also Access: Apps and Policies > Edit and Access: Organizations, Identity Providers, and Groups > Edit
CLOUDFLARE_API_TOKEN=

# --- Tailscale provider: an OAuth client (doesn't expire; product README "Tailscale OAuth client for Terraform") ---
# `mcctl init` creates it through the API. By hand: Admin console > Settings > Trust credentials > OAuth client. Scopes: policy_file,
# devices:posture_attributes, devices:core:read, auth_keys, federated_keys. Tags: tag:mc-server, tag:ci.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# One-off, FIRST apply only (the tags must exist in the policy before the OAuth client can own them):
#   TAILSCALE_API_KEY=... mcctl apply --target tailscale_acl.this   (mcctl then drops the OAuth variables)
# Never keep it here: it conflicts with the OAuth client variables. Revoke it afterwards.

# --- GitHub provider ---
# Fine-grained PAT, this config repo only: Secrets (read/write), Administration (read/write: the rulesets),
# Metadata (read)
GITHUB_TOKEN=

# --- Only while the product repo is private: a fine-grained PAT with Contents: read on the product repo.
# Terraform stores it as the PRODUCT_READ_TOKEN Actions secret (the reusable workflow checks out the product).
TF_VAR_product_read_token=

# --- Optional Discord alerts (server.yml alerts.discord: true). Terraform stores the webhook in its state, as an
# Actions secret for the deploy and as a secret of the watchdog Worker (which needs no setup of its own).
TF_VAR_discord_webhook_url=

# --- Optional Discord slash commands (server.yml discord.commands: true; `mcctl setup` asks). The application's
# bot token (developer portal > your application > Bot > Reset Token): only mcctl uses it, to register the
# commands and set the interactions endpoint (`mcctl discord sync`). Terraform, CI, the Worker and the server
# never get it.
DISCORD_BOT_TOKEN=

# --- Only with server.yml panel.access.idp: github: the GitHub OAuth app's client secret (its client id goes in
# panel.access.github_client_id). Terraform gives it to the panel's Cloudflare Access login.
TF_VAR_panel_github_client_secret=

# --- Ansible: nothing to set here. Deploy secrets (MC_SECRET_*) come from Terraform outputs:
#   mcctl deploy -C <this repo>   # runs the pinned product; CI maps the Actions secrets instead.
