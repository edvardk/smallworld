# {{ ansible_managed }}
# The weekly backup test (scripts/backup_check.py; until v1.2 the config repo's Monday Actions job): restic check
# on 5% of the data, then the newest snapshot restored into this unit's private /var/tmp and verified. A failure
# alerts Discord (DISCORD_WEBHOOK_URL in restic.env) and fails the unit. Runs as {{ mc_ops_user }} with the restic
# credentials, like mc-backup, but needs no capability: it only reads the repository and writes its scratch copy.
[Unit]
Description=Weekly backup test (restic check + restore of the newest snapshot)
Wants=network-online.target
After=network-online.target
# Never on a box `mcctl migrate` fenced: another box owns the world (removed only by mcctl's unfence).
ConditionPathExists=!{{ mc_state_dir }}/fenced

[Service]
Type=oneshot
# Not minecraft: code in the JVM must not be able to read this process's environment (restic/R2 keys).
User={{ mc_ops_user }}
Group={{ mc_ops_user }}
SupplementaryGroups=minecraft
EnvironmentFile={{ mc_etc_dir }}/restic.env
Environment=RESTIC_CACHE_DIR={{ backups_cache_dir }} PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
{% if backups_restic_gomaxprocs %}
# v1.5 performance.vm small: restic (Go) on {{ backups_restic_gomaxprocs }} core(s), its GC aiming below the memory limit.
Environment=GOMAXPROCS={{ backups_restic_gomaxprocs }}
{% endif %}
{% if backups_restic_memory_limit_mb %}
Environment=GOMEMLIMIT={{ backups_restic_memory_limit_mb }}MiB
{% endif %}
CacheDirectory=mc-restic
CacheDirectoryMode=0750
ExecStart={{ mc_bin_dir }}/backup_check.py --max-age-hours {{ backups_check_max_age_hours }}
TimeoutStartSec=3h
# If memory runs out, sacrifice the test rather than the server.
OOMScoreAdjust=500
{% if backups_memory_high_mb %}
MemoryHigh={{ backups_memory_high_mb }}M
{% endif %}
# P13: idle priority (never competes with the tick), see mc_helper_priority.
{{ mc_helper_priority | join('\n') }}
{% if mc_helper_cpus %}
AllowedCPUs={{ mc_helper_cpus }}
{% endif %}
# Sandbox (design §7): the shared set, see ansible/group_vars/all/main.yml. The scratch copy lives in the
# private /var/tmp (PrivateTmp=true), removed with the unit's run.
{{ mc_systemd_sandbox | join('\n') }}
MemoryDenyWriteExecute=true
InaccessiblePaths={{ backups_inaccessible_paths | join(' ') }}
