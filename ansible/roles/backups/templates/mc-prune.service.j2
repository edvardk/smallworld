# {{ ansible_managed }}
[Unit]
Description=Prune unreferenced restic data (weekly)
Wants=network-online.target
After=network-online.target minecraft.service
# Never on a box `mcctl migrate` fenced: another box owns the world (removed only by mcctl's unfence).
ConditionPathExists=!{{ mc_state_dir }}/fenced

[Service]
Type=oneshot
# Not minecraft: code in the JVM must not be able to read this process's environment (restic/R2 keys).
User={{ mc_ops_user }}
Group={{ mc_ops_user }}
SupplementaryGroups=minecraft
EnvironmentFile={{ mc_etc_dir }}/restic.env
Environment=RESTIC_CACHE_DIR={{ backups_cache_dir }} PYTHONDONTWRITEBYTECODE=1
# Packs younger than the bucket lock can't be deleted. restic's default retry (feature flag
# backend-error-redesign, beta in 0.19.1) retries each refused Remove for up to 15 minutes, because R2's
# "object is locked" error isn't one it treats as permanent: with a few dozen young packs prune held the
# repository lock for hours and the hourly backups failed waiting for it. The previous behaviour gives up
# after 10 retries (about a minute); prune skips the pack either way and deletes it on a later run.
# tests/test_backup.py ties this to restic_version (an unknown flag stops restic from starting).
Environment=RESTIC_FEATURES=backend-error-redesign=false
{% if backups_restic_gomaxprocs %}
# v1.5 performance.vm small: restic (Go) on {{ backups_restic_gomaxprocs }} core(s), its GC aiming below the memory limit.
Environment=GOMAXPROCS={{ backups_restic_gomaxprocs }}
{% endif %}
{% if backups_restic_memory_limit_mb %}
Environment=GOMEMLIMIT={{ backups_restic_memory_limit_mb }}MiB
{% endif %}
CacheDirectory=mc-restic
CacheDirectoryMode=0750
ExecStart={{ mc_bin_dir }}/backup.py --prune
# If memory runs out, sacrifice restic rather than the server.
OOMScoreAdjust=500
{% if backups_memory_high_mb %}
MemoryHigh={{ backups_memory_high_mb }}M
{% endif %}
# P13: idle priority (never competes with the tick), see mc_helper_priority.
{{ mc_helper_priority | join('\n') }}
{% if mc_helper_cpus %}
AllowedCPUs={{ mc_helper_cpus }}
{% endif %}
# Sandbox (design §7): the shared set, see ansible/group_vars/all/main.yml.
{{ mc_systemd_sandbox | join('\n') }}
MemoryDenyWriteExecute=true
