# {{ ansible_managed }}
WATCHDOG_URL={{ mc_watchdog_url }}
HEARTBEAT_TOKEN={{ mc_secret_heartbeat_token }}
DISCORD_WEBHOOK_URL={{ mc_secret_discord_webhook_url }}
MSPT_ALERT={{ health_mspt_alert }}
MSPT_ALERT_CHECKS={{ health_mspt_alert_checks }}
HEAP_ALERT_PCT={{ health_heap_alert_pct }}
HEAP_ALERT_CHECKS={{ health_heap_alert_checks }}
GC_PAUSE_ALERT_MS={{ health_gc_pause_alert_ms }}
REPEAT_HOURS={{ health_alert_repeat_hours }}
DISK_ALERT_PCT={{ health_disk_alert_pct }}
STEAL_ALERT_PCT={{ health_steal_alert_pct }}
STEAL_ALERT_CHECKS={{ health_steal_alert_checks }}
RESIZE_HINT={{ mc_resize_hint }}
HEAL_STARTUP_GRACE_S={{ monitoring_heal_startup_grace_s }}
{# Chunky pre-generation (health.py): the dimensions with a border, overworld -> nether -> end, as Bukkit world names
   derived from level-name (world, world_nether, world_the_end); empty when Chunky isn't locked. #}
{% set ns = namespace(worlds=[]) %}
{% for dim, suffix in [['minecraft:overworld', ''], ['minecraft:the_nether', '_nether'], ['minecraft:the_end', '_the_end']] %}
{% if dim in mc_world_border_radius %}{% set ns.worlds = ns.worlds + [mc_level_name ~ suffix] %}{% endif %}
{% endfor %}
PREGEN_WORLDS={{ ns.worlds | join(',') if monitoring_pregen_enabled and (mc_world_pregen | default(true)) and 'chunky' in (plugins_lock.plugins | map(attribute='name') | map('lower') | list) else '' }}
