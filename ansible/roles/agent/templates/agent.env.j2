# {{ ansible_managed }}
INGEST_URL={{ agent_ingest_url }}
AGENT_TOKEN={{ mc_secret_agent_token }}
COMMAND_HMAC_KEY={{ mc_secret_command_hmac_key }}
METRICS_INTERVAL_S={{ mc_metrics_interval_s }}
LOG_BATCH_S={{ agent_log_batch_s }}
LOG_MAX_ROWS_PER_DAY={{ mc_logs_max_rows_per_day }}
POLL_S={{ agent_poll_s }}
WATCHDOG_URL={{ mc_watchdog_url }}
HEARTBEAT_TOKEN={{ mc_secret_heartbeat_token }}
# P10: expired panel whitelist changes are announced on Discord; the whitelist pull requests go to the config
# repo with short-lived tokens of the panel's GitHub App, which the Worker mints (no GitHub credential here).
DISCORD_WEBHOOK_URL={{ mc_secret_discord_webhook_url }}
CONFIG_REPO={{ mc_config_repo }}
PANEL_SYNC_S={{ agent_panel_sync_s }}
PANEL_BATCH_S={{ agent_panel_batch_s }}
PANEL_PR_CHECK_S={{ agent_panel_pr_check_s }}
# P13: player-experience telemetry (the mc-telemetry plugin's snapshots -> minute rows -> the Worker)
EXPERIENCE={{ '1' if mc_experience_enabled else '0' }}
TELEMETRY_DIR={{ mc_telemetry_dir }}
VERDICT_DIR={{ mc_verdict_dir }}
SEGMENT_DIR=/var/lib/mc-telemetry/segments
SEGMENT_DAYS={{ mc_experience_segment_days }}
SEGMENT_CAP_MB={{ mc_experience_segment_cap_mb }}
SEGMENT_S={{ agent_segment_s }}
BACKFILL_WINDOW={{ mc_experience_backfill_window }}
MESSAGE_PER_PLAYER_S={{ mc_experience_message_per_player_s }}
MESSAGE_BROADCAST_S={{ mc_experience_broadcast_s }}
MESSAGE_PER_HOUR={{ mc_experience_messages_per_hour }}
LEVEL_NAME={{ mc_level_name }}
# v1.1: /modpack's one-time codes (mc-brand's requests -> the Worker -> the code file mc-brand reads)
CLIENT={{ '1' if mc_client_enabled else '0' }}
CLIENT_REQUEST_DIR={{ mc_client_request_dir }}
CLIENT_CODE_FILE={{ mc_client_code_file }}
{% if agent_github_api_url %}
GITHUB_API_URL={{ agent_github_api_url }}
{% endif %}
