# {{ ansible_managed }}
# mc-telemetry (v1.4, agent.implementation rust with experience on): the player-experience telemetry
# (scripts/telemetry.py) in a unit of its own, because the Rust agent doesn't port it (design §1.3). Same code,
# inputs and outputs as inside the Python agent: the plugin's snapshots -> minute rows and segments to the Worker,
# verdicts back to the plugin, the box's segment copy; plus /var/lib/mc-telemetry/online.json (who is online, read
# by the Rust agent's player_message) and systemd's per-run resource lines from its own journal reader. Runs as
# {{ mc_ops_user }}, never as minecraft: it reads agent.env (the agent token).
[Unit]
Description=Minecraft experience telemetry (plugin snapshots -> Cloudflare Worker), beside the Rust mc-agent
Wants=network-online.target
After=network-online.target minecraft.service mc-agent.service
# Never on a box `mcctl migrate` fenced (as mc-agent).
ConditionPathExists=!{{ mc_state_dir }}/fenced

[Service]
Type=simple
User={{ mc_ops_user }}
Group={{ mc_ops_user }}
SupplementaryGroups=minecraft systemd-journal
EnvironmentFile={{ mc_etc_dir }}/agent.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# mc-agent first: telemetry-id.json stays where the Python agent keeps it (the rows' source id and sequence carry
# over a switch either way); mc-telemetry: segments, online.json, the journal cursor.
StateDirectory=mc-agent mc-telemetry
StateDirectoryMode=0700
UMask=0077
ExecStart={{ mc_bin_dir }}/mc_agent.py telemetry
Restart=always
RestartSec=10
MemoryHigh=48M
MemoryMax=64M
CPUQuota=20%
OOMScoreAdjust=500
# P13: timely priority (has a deadline; the JVM still wins 10:1), see mc_timely_priority.
{{ mc_timely_priority | join('\n') }}
{% if mc_helper_cpus %}
AllowedCPUs={{ mc_helper_cpus }}
{% endif %}
# Sandbox (design §7): the shared set, see ansible/group_vars/all/main.yml.
{{ mc_systemd_sandbox | join('\n') }}
MemoryDenyWriteExecute=true
# verdicts.tsv for the mc-telemetry plugin (tmpfs, setgid minecraft; the plugin reads it, never writes)
ReadWritePaths={{ mc_verdict_dir }}

[Install]
WantedBy=multi-user.target
