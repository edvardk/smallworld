#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Only our own table is replaced on reload (no `flush ruleset`), so Tailscale's tables survive.
# Public: TCP 25565 (Minecraft) + UDP 41641 (Tailscale direct connections, WireGuard; silent to scans).
# Everything else, including SSH and RCON, is reachable only via tailscale0.
# New Minecraft connections are limited per source (IPv4 /32, IPv6 /64): {{ firewall_mc_new_per_minute }}/minute
# with a burst of {{ firewall_mc_new_burst }}, and at most {{ firewall_mc_max_concurrent }} at once (server.yml firewall.max_connections_per_source).
# Drops are logged, rate-limited. Fail closed: when a per-source set is full (an attacker spraying sources, e.g.
# an IPv6 /48 = 65536 /64s), a new source can't be tracked, and instead of slipping through unlimited it is
# dropped ("mc-setfull: ", counter) until entries expire; sources already in the sets keep working.
table inet mc_filter
delete table inet mc_filter

table inet mc_filter {
  # Per-source state; entries expire on their own (rate sets after 10 min idle, connection counts at 0).
  set mc_rate_v4 { type ipv4_addr; size {{ firewall_set_size }}; flags dynamic; timeout 10m; }
  set mc_rate_v6 { type ipv6_addr; size {{ firewall_set_size }}; flags dynamic; timeout 10m; }
  set mc_conn_v4 { type ipv4_addr; size {{ firewall_set_size }}; flags dynamic; }
  set mc_conn_v6 { type ipv6_addr; size {{ firewall_set_size }}; flags dynamic; }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    iifname "tailscale0" accept
    meta l4proto { icmp, ipv6-icmp } accept
    udp dport 41641 accept comment "tailscale direct"
    tcp dport 25565 ct state new jump minecraft_new comment "minecraft"
  }

  chain minecraft_new {
    update @mc_rate_v4 { ip saddr limit rate over {{ firewall_mc_new_per_minute }}/minute burst {{ firewall_mc_new_burst }} packets } jump drop_rate
    update @mc_rate_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: limit rate over {{ firewall_mc_new_per_minute }}/minute burst {{ firewall_mc_new_burst }} packets } jump drop_rate
    add @mc_conn_v4 { ip saddr ct count over {{ firewall_mc_max_concurrent }} } jump drop_conn
    add @mc_conn_v6 { ip6 saddr & ffff:ffff:ffff:ffff:: ct count over {{ firewall_mc_max_concurrent }} } jump drop_conn
    # A full set adds nothing, and then the statements above can't match: without these lines the connection
    # would be accepted with no limit at all. Only a source present in both of its family's sets gets in.
    ip saddr != @mc_rate_v4 jump drop_full
    ip saddr != @mc_conn_v4 jump drop_full
    ip6 saddr & ffff:ffff:ffff:ffff:: != @mc_rate_v6 jump drop_full
    ip6 saddr & ffff:ffff:ffff:ffff:: != @mc_conn_v6 jump drop_full
    accept
  }

  chain drop_full {
    limit rate {{ firewall_log_per_minute }}/minute burst 5 packets log prefix "mc-setfull: " level warn
    counter drop
  }

  chain drop_rate {
    limit rate {{ firewall_log_per_minute }}/minute burst 5 packets log prefix "mc-ratelimit: " level info
    counter drop
  }

  chain drop_conn {
    limit rate {{ firewall_log_per_minute }}/minute burst 5 packets log prefix "mc-connlimit: " level info
    counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
