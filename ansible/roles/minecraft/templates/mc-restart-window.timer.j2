# {{ ansible_managed }}
[Unit]
Description=Restart Minecraft at the maintenance window's start if a deploy left a restart pending (v1.3)

[Timer]
# The window's start in its own time zone, then every 15 minutes (restart_window.py decides: inside the window,
# nothing in the way); the service's ConditionPathExists skips it when nothing is pending.
OnCalendar=*-*-* {{ mc_maintenance_window.split('-')[0] }}:00 {{ mc_maintenance_timezone }}
OnCalendar=*-*-* *:00/15:00
AccuracySec=1min

[Install]
WantedBy=timers.target
